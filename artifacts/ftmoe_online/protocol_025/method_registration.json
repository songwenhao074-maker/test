{
  "protocol": "025",
  "registered_before_any_model_result": true,
  "development_seed": 700,
  "model_seed": 1,
  "target": "raw_next_fault",
  "target_maturity": "t_plus_2",
  "confirmation_seeds_forbidden": [701, 702, 703],
  "test_seeds_forbidden": [201, 202, 203, 204, 205],
  "data_source": "Protocol025 seed700 immutable stream after pre-model audit pass",
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "update_every_scored_intervals": 4,
    "batch_size": 32,
    "gradient_steps_per_opportunity": 1,
    "replay_buffer_intervals": 64,
    "distill_weight": 0.10,
    "gradient_clip_norm": 1.0,
    "online_updates_continue_through_stream": true,
    "F0_prefix_is_causal_burn_in": true,
    "no_future_phase_or_service_id": true
  },
  "common_observable_head": {
    "enabled": true,
    "features": ["normalized_cpu_pressure","normalized_ram_pressure","normalized_disk_pressure","cpu_delta_1","ram_delta_1","disk_delta_1","cpu_slope_4","ram_slope_4","disk_slope_4"],
    "architecture": "LayerNorm(9)-Linear(9,16)-GELU-Linear(16,5)",
    "final_layer_zero_initialized": true,
    "shared_identically_by_all_learned_comparators": true,
    "trained_only_on_matured_causal_labels": true,
    "D_shadow_training_does_not_update_common_head": true
  },
  "fixed_bank_initialization": {
    "expert_architecture": "LayerNorm(64)-Linear(64,32)-GELU-Linear(32,5)",
    "final_layer_zero_initialized": true,
    "per_expert_seed_base": 250100,
    "router_row_seed_base": 250200,
    "shared_prefix_rule": "expert/router rows 0..3 are byte-identical across fixed4,fixed5,fixed8 and D initial generalists",
    "no_initialization_from_future_D_specialists": true
  },
  "comparators": {
    "pressure_visible_score": "nonlearned_same_information_reference",
    "C_fixed4": {"experts":4,"router":"dense_softmax","live_active_experts":4},
    "C_fixed5": {"experts":5,"router":"dense_softmax","live_active_experts":5},
    "C_fixed8_dense": {"experts":8,"router":"dense_softmax","live_active_experts":8},
    "C_fixed8_top5": {"experts":8,"router":"top5_then_softmax","live_active_experts":5},
    "D_dynamic": {"generalists":4,"max_live_specialists":1,"resident_limit":8,"shadow_counts_as_resident":true,"normal_live_active_experts":5,"crossfade_may_temporarily_activate_two_specialists":true}
  },
  "dynamic_policy": {
    "source_semantics": "Protocol024 v2c replacement-consistent lifecycle",
    "birth_shadow_budget": "buffer128_4x4",
    "proposal_start_matured": 600,
    "proposal_every_matured": 256,
    "candidate_train_horizon_intervals": 128,
    "candidate_buffer_size": 64,
    "candidate_minibatch": 32,
    "candidate_update_every_matured": 4,
    "candidate_updates_per_opportunity": 4,
    "candidate_validation_intervals": 32,
    "accept_relative_supervised_loss_improvement": 0.01,
    "normal_probability_allowance": 0.01,
    "validation_fpr_delta_allowance": 0.01,
    "old_knowledge_guard_source": "causally observed F0 rows with deterministic modulo-5 subset; candidate never trains on guard rows",
    "guard_loss_relative_increase_allowance": 0.02,
    "guard_fpr_delta_allowance": 0.01,
    "birth_preview_topology": "four_generalists_plus_new_specialist_replacing_old_specialist",
    "reuse_every_matured": 32,
    "reuse_recent_visible_z_intervals": 32,
    "reuse_selection": "max cosine to frozen centroid, must clear causal q10 within-memory threshold",
    "reuse_validation_intervals": 16,
    "crossfade_prediction_intervals": 8,
    "purge_rule": "dormant specialist with oldest last causal acceptance timestamp, expert ID tie-break",
    "purge_never_generalist_active_or_validating": true,
    "service_id_not_used_by_policy": true
  },
  "evaluation": {
    "registered_recurrence_windows": ["S1_rec1","S3_rec1","S2_rec1","S4_rec1","S2_rec2","S6_rec1","S1_rec2","S5_rec1","S3_rec2"],
    "window_length": 100,
    "active_budget_primary_comparator": "C_fixed5",
    "primary_metric": "equal_weight_mean_D_dynamic_minus_C_fixed5_AP_over_registered_recurrence_first100",
    "legacy_data_registration_metric_also_reported": "equal_weight_mean_D_dynamic_minus_C_fixed4_AP_over_registered_recurrence_first100",
    "reason_for_pre_result_correction": "D normally has 4 generalists plus 1 live specialist, so C_fixed5 is the literal same-active-expert comparator; this correction is frozen before any Protocol025 model result",
    "report_all_comparators_without_ranking_substitution": true,
    "secondary_metrics": ["full_stream_ap","recall","fpr","resource_macro_f1","onset_ap","cumulative_optimizer_steps","training_interval_repeats","cpu_seconds","peak_rss_bytes","resident_bytes","p95_inference_latency"]
  },
  "hard_delete_claim": {
    "requires_real_capacity_block": true,
    "requires_purge_gt_0": true,
    "requires_D_no_purge_control": true,
    "otherwise_no_hard_delete_benefit_claim": true
  },
  "stop_rule": "run the frozen seed700 development comparison once after data audit; do not tune acceptance/reuse thresholds on its outcome; confirmation remains sealed until a later explicit freeze decision"
}
